{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/policy.py\"",
            "timeout": 10,
            "statusMessage": "Защита файлов"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/policy.py\"",
            "timeout": 30,
            "statusMessage": "Ruff format и check"
          }
        ]
      }
    ]
  }
}
