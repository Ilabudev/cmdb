{
  "permissions": {
    "allow": [
      "Bash(ruff check *)",
      "Bash(ruff format --check *)",
      "Bash(.venv/bin/ruff check *)",
      "Bash(.venv/bin/ruff format --check *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r -f *)",
      "Bash(rm -f -r *)"
    ],
    "ask": [
      "Bash(git push *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.sh\"",
            "timeout": 10,
            "statusMessage": "protect-files..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in \"$CLAUDE_PROJECT_DIR\"/backend/*.py) cd \"$CLAUDE_PROJECT_DIR/backend\" && .venv/bin/ruff format -q \"$f\" >/dev/null 2>&1; out=$(.venv/bin/ruff check \"$f\" 2>&1) || { echo \"$out\" >&2; exit 2; };; esac",
            "timeout": 30,
            "statusMessage": "ruff format + check..."
          }
        ]
      }
    ]
  }
}
